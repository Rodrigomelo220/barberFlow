Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>
<FilesMatch "^(config\.php|\.htaccess|.*\.sql|.*\.log)$">
  Require all denied
</FilesMatch>
